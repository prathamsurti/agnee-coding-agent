# ==============================================================================
# AGNI DEV ENVIRONMENT CONFIGURATION
# ==============================================================================

# General
ENV=development
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL 16 with pgvector or SQLite for local dev)
DATABASE_URL=postgresql+asyncpg://agni:agni_secret@localhost:5432/agni_db
# Local SQLite fallback option:
# DATABASE_URL=sqlite+aiosqlite:///./agni_local.db

# Redis Configuration (Dockerized)
REDIS_URL=redis://localhost:6379/0

# Asymmetric Ed25519 Keys (Run 'python generate_keys.py' to generate a persistent pair)
# If left empty, API Gateway will generate an ephemeral keypair on startup
ED25519_PRIVATE_KEY_PEM=""
ED25519_PUBLIC_KEY_PEM=""

# Session & Token Lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_FAMILY_GRACE_PERIOD_SECONDS=30

# RFC 8628 Device Flow
DEVICE_CODE_EXPIRE_SECONDS=300
DEVICE_POLL_INTERVAL_SECONDS=2

# Agent LLM Provider Keys (Optional: Bring Your Own Key)
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
